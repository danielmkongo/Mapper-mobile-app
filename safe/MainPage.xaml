<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="safe.MainPage"
    BackgroundColor="#071224">

    <Grid RowDefinitions="Auto, * , Auto" Padding="12,-10,12,12" >

        <!-- Header -->
        <Grid Row="0" HeightRequest="50" Padding="4">
            <Frame BackgroundColor="#05283E" HasShadow="False" Padding="10" CornerRadius="0">
                <Grid>
                    <!--<Label Text="←" HorizontalOptions="Start" VerticalOptions="Center" TextColor="White" FontAttributes="Bold" />-->
                    <Label Text="Mapper" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" FontSize="14" />
                </Grid>
            </Frame>
        </Grid>

        <!-- Middle map / layout -->
        <ScrollView Grid.Row="1" Orientation="Vertical" HorizontalOptions="Fill" VerticalOptions="Fill">
            <VerticalStackLayout Spacing="20" HorizontalOptions="Center" Padding="0">

                <!-- Container for MapLayout to fix size & center -->
                <Grid WidthRequest="360" HeightRequest="500" HorizontalOptions="Center" VerticalOptions="Center">
                    <AbsoluteLayout x:Name="MapLayout" HeightRequest="450" WidthRequest="360" BackgroundColor="#22293A" >

                        <!-- Room blueprint border (approximate) -->
                        <Frame AbsoluteLayout.LayoutBounds="0.05,0.05,0.96,0.96" AbsoluteLayout.LayoutFlags="SizeProportional"
                               BackgroundColor="#2d343b" BorderColor="#9aa7b1" CornerRadius="4" Opacity="0.4" HasShadow="False" Padding="0">
                            <!-- Optional: add blueprint interior lines using BoxViews or shapes here -->
                        </Frame>

                        <!-- Anchors and subjects will be added dynamically in code-behind -->
                    </AbsoluteLayout>
                </Grid>

                <!-- Legend -->
                <VerticalStackLayout HorizontalOptions="Center" Spacing="6" Padding="5,0,5,0">
                    <Label Text="•    Red: UWB Devices (People)" TextColor="White" FontSize="12" />
                    <Label Text="•    Green: UWB Anchors (Temp)" TextColor="White" FontSize="12" />
                    <Label Text="•    Blue Waves: Signal Range" TextColor="#3fb0ff" FontSize="12" />
                </VerticalStackLayout>

                <!-- Activity title -->
                <Label Text="Overall Room Activity" TextColor="White" FontAttributes="Bold" FontSize="16" HorizontalOptions="Start" />

                <!-- Activity graph using SkiaSharp -->
                <Frame BackgroundColor="#0b1b2a" HasShadow="False" Padding="8" CornerRadius="6" HeightRequest="140" WidthRequest="360">
                    <GraphicsView x:Name="ActivityGraphView" HeightRequest="140" WidthRequest="344" />
                </Frame>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
