<?xml version="1.0" encoding="utf-8" ?>
<!--
  Mapper mobile: a native shell around the hub's live console (3D twin, people, alerts).
  The console is the same web app the control room uses, so phone and desktop never
  disagree; this page adds what only a native app can: remembering the hub, a proper
  connection screen, and keeping the screen awake while monitoring.
-->
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="safe.MainPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#0B1016">

    <Grid>
        <WebView x:Name="Console"
                 Navigating="OnNavigating"
                 Navigated="OnNavigated" />

        <!-- Connection screen: first run, or whenever the hub cannot be reached -->
        <Grid x:Name="Connect" BackgroundColor="#0B1016" Padding="28,0">
            <VerticalStackLayout VerticalOptions="Center" Spacing="18" MaximumWidthRequest="420">

                <Grid HeightRequest="96" WidthRequest="96" HorizontalOptions="Center">
                    <Ellipse Stroke="#3FC6FF" StrokeThickness="2" Opacity="0.35" WidthRequest="96" HeightRequest="96" />
                    <Ellipse Stroke="#3FC6FF" StrokeThickness="2" Opacity="0.7" WidthRequest="60" HeightRequest="60" />
                    <Ellipse Fill="#3FC6FF" WidthRequest="22" HeightRequest="22" />
                </Grid>

                <Label Text="MAPPER" TextColor="#E7EDF3" FontSize="30" FontAttributes="Bold"
                       CharacterSpacing="6" HorizontalOptions="Center" />
                <Label Text="Live indoor tracking" TextColor="#8B98A8" FontSize="15" HorizontalOptions="Center" />

                <Border x:Name="StatusCard" BackgroundColor="#141B24" Stroke="#243241" StrokeThickness="1"
                        Padding="14,12" StrokeShape="RoundRectangle 12" IsVisible="False">
                    <Label x:Name="Status" TextColor="#FFB020" FontSize="14" LineBreakMode="WordWrap" />
                </Border>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Hub address" TextColor="#8B98A8" FontSize="13" />
                    <Border BackgroundColor="#141B24" Stroke="#243241" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="12,2">
                        <Entry x:Name="HubUrl" TextColor="#E7EDF3" PlaceholderColor="#5D6B7B"
                               Placeholder="http://192.168.1.20:8080" Keyboard="Url"
                               ReturnType="Go" Completed="OnConnect" />
                    </Border>
                    <Label Text="The computer or server running the Mapper hub. On the same Wi-Fi, use its IP and port 8080."
                           TextColor="#5D6B7B" FontSize="12" LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <Button x:Name="ConnectButton" Text="Connect" Clicked="OnConnect"
                        BackgroundColor="#3FC6FF" TextColor="#06121C" FontAttributes="Bold"
                        CornerRadius="10" HeightRequest="50" />
                <ActivityIndicator x:Name="Busy" Color="#3FC6FF" IsRunning="False" IsVisible="False" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
